# Copiar a .env y completar. docker compose lo lee automáticamente.
GCP_PROJECT_ID=mi-proyecto-123
GCP_REGION=us-central1
# Ubicación de Vertex AI. Los modelos Gemini 3.x se sirven desde el endpoint global.
GCP_VERTEX_LOCATION=global
# Credenciales ADC para Vertex AI en local (ver doc/4-extractor-vertex.md)
GCP_ADC_PATH=${HOME}/.config/gcloud-psychometrics/application_default_credentials.json
